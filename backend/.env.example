# Application Settings
APP_NAME="Healthcare Booking API"
DEBUG=False

# Database
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/healthcare_booking"

# Security
# IMPORTANT: Generate a secure random secret key for production
# You can generate one using: python3 -c "import secrets; print(secrets.token_hex(32))"
# Or using: openssl rand -hex 32
SECRET_KEY="your-secret-key-here-generate-using-secrets-token-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
# Comma-separated list of allowed origins for CORS
# Example: ["http://localhost:5173","https://yourdomain.com"]
CORS_ORIGINS=["http://localhost:5173"]

# MediaPipe Configuration
# Model complexity: 0=Lite (fastest), 1=Full (balanced), 2=Heavy (most accurate)
# Higher complexity provides better accuracy but requires more computational resources
MEDIAPIPE_MODEL_COMPLEXITY=2

# Minimum confidence threshold for initial pose detection (0.0 to 1.0)
# Lower values detect poses more easily but may have more false positives
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.7

# Minimum confidence threshold for pose tracking between frames (0.0 to 1.0)
# Lower values track poses more easily but may be less stable
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.7

# Posture Analysis Configuration
# Session timeout in minutes for posture analysis sessions
# Sessions expire after this duration to prevent stale sessions
ANALYSIS_SESSION_TIMEOUT_MINUTES=15

