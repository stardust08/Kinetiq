// =========================
// Generator & Datasource
// =========================
generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// =========================
// Enums
// =========================
enum UserRole {
  USER
  CLINICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpType {
  LOGIN
  SIGNUP
  RESET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  FULL
  PARTIAL
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

/// Which screening a plan or a supervised call was built around.
enum AnalysisType {
  POSTURE
  GAIT
  ROM
}

/// A prescription is generated by the rules engine but is NOT a clinical instruction
/// until a clinician has looked at it. DRAFT exists so an automated suggestion can
/// never reach a patient unreviewed.
enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum PlanItemSource {
  AUTO
  MANUAL
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Region an exercise loads. Matched against the body region a finding implicates,
/// so it is an enum rather than free text - a typo'd region silently drops an
/// exercise out of every recommendation.
enum BodyRegion {
  CERVICAL
  SHOULDER
  ELBOW
  THORACIC
  LUMBAR
  PELVIS
  HIP
  KNEE
  ANKLE
  FOOT
  FULL_BODY
}

enum VideoSessionStatus {
  SCHEDULED
  WAITING
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  PATIENT
  CLINICIAN
  ADMIN
  OBSERVER
}

// =========================
// Models
// =========================

model User {
  id                     String        @id @default(uuid())
  email                  String?       @unique
  name                   String?
  role                   UserRole
  phone                  String        @unique
  passwordHash           String?
  status                 UserStatus    @default(ACTIVE)
  createdAt              DateTime      @default(now())
  profileImage           String?
  sessionCount           Int           @default(0)
  notificationPreference Json?

  carts                  Cart[]
  bookings               Booking[]
  slotLocks       SlotLock[]  @relation("UserSlotLocks")
  subscriptions          Subscription[]
  reports                Report[]
  payments               Payment[]
  postureAnalyses        PostureAnalysis[]
  gaitAnalyses           GaitAnalysis[]
  romAnalyses    ROMAnalysis[]

  // --- Role-specific relations ---------------------------------------------
  clinicianProfile       ClinicianProfile?
  clinicianBookings      Booking[]      @relation("ClinicianBookings")

  // --- Exercise prescription ----------------------------------------------
  exercisePlans          ExercisePlan[] @relation("PatientPlans")
  authoredPlans          ExercisePlan[] @relation("PlanAuthor")
  reviewedPlans          ExercisePlan[] @relation("PlanReviewer")
  exerciseCompletions    ExerciseCompletion[]
  authoredExercises      Exercise[]     @relation("ExerciseAuthor")

  // --- Video consultation --------------------------------------------------
  patientSessions        VideoSession[] @relation("PatientSessions")
  clinicianSessions      VideoSession[] @relation("ClinicianSessions")
  videoParticipations    VideoSessionParticipant[]
  videoEvents            VideoSessionEvent[]

  @@index([role, status])
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  status      String?
  createdAt   DateTime @default(now())

  services    Service[]
  
  @@index([status])
  @@index([slug])
}

model Service {
  id              String      @id @default(uuid())
  categoryId      String
  name            String
  slug            String      @unique
  description     String?
  
  // Pricing
  basePrice       Float
  salePrice       Float?
  discount        Float?
  
  // Payment Configuration
  paymentType     PaymentType @default(FULL)
  advancePercent  Float?
  advanceAmount   Float?
  
  // Service Metadata
  duration        String?
  serviceType     String?
  features        Json?
  reviewCount     Int         @default(0)
  deliveryMode    String?
  sessionCount    Int?
  slotLocks       SlotLock[]
  
  // AI Screening Configuration
  includedScreeningCount  Int?
  
  createdAt       DateTime    @default(now())

  category        Category         @relation(fields: [categoryId], references: [id])
  bookings        Booking[]
  subscriptions   Subscription[]
  
  @@index([categoryId])
  @@index([slug])
  @@index([paymentType])
}

model SlotLock {
  id              String    @id @default(uuid())
  serviceId       String
  userId          String
  slotTime        DateTime

  /// Which clinician's calendar this lock consumes. Null means "any clinician", the
  /// pre-existing behaviour. Without this a single lock blocked one time slot across
  /// the whole service, so two clinicians could never be booked at the same hour.
  clinicianId     String?

  lockedAt        DateTime  @default(now())
  expiresAt       DateTime
  isReleased      Boolean   @default(false)

  service         Service   @relation(fields: [serviceId], references: [id])
  user            User      @relation("UserSlotLocks", fields: [userId], references: [id])

  /// Composite so the same hour can be held on two different clinicians' calendars.
  /// SlotService reuses a released or expired row rather than inserting a second one -
  /// with a unique key on the slot, inserting again after a release fails forever.
  @@unique([serviceId, slotTime, clinicianId])
  @@index([expiresAt, isReleased])
  @@index([userId, isReleased])
  @@index([serviceId, slotTime])
  @@index([clinicianId, slotTime])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String
  cartValue Float    @default(0)

  items     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  otp       String
  phoneNo   String
  type      OtpType
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phoneNo])
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float         @default(0)
  
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  transactionId   String?
  
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  
  user            User          @relation(fields: [userId], references: [id])
  bookings        Booking[]
  
  @@index([userId])
  @@index([transactionId])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  serviceId   String
  paymentId   String
  clinicianId String?
  
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float     @default(0)
  
  time        DateTime
  createdAt   DateTime      @default(now())
  status      BookingStatus @default(PENDING)
  description String?
  
  // AI Screening Count Management
  totalScreeningCount     Int       @default(0)
  usedScreeningCount      Int       @default(0)
  remainingScreeningCount Int       @default(0)

  user        User          @relation(fields: [userId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
  /// clinicianId existed as a bare string, so nothing could load the assigned
  /// clinician without a second query and nothing stopped it pointing at a patient.
  clinician   User?         @relation("ClinicianBookings", fields: [clinicianId], references: [id])
  reports     Report[]
  postureAnalyses PostureAnalysis[]
  gaitAnalyses GaitAnalysis[]
  romAnalyses    ROMAnalysis[]
  videoSessions  VideoSession[]
  exercisePlans  ExercisePlan[]

  @@index([userId])
  @@index([paymentId])
  @@index([serviceId, time, status])
  @@index([userId, remainingScreeningCount])
  @@index([time])
  @@index([clinicianId, time])
  @@index([status, time])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  bookingId   String
  reportUrl   String
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String
  serviceId    String
  amount       Float
  createdAt    DateTime @default(now())
  startAt      DateTime
  expirationAt DateTime

  user         User     @relation(fields: [userId], references: [id])
  service      Service  @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([serviceId])
}

model PostureAnalysis {
  id                      String    @id @default(uuid())
  userId                  String
  bookingId               String
  analysisDate            DateTime  @default(now())
  
  // I. Global Posture (8 metrics)
  fhdPixels               Float?
  cervicalAngle           Float?
  headLateralFlexion      Float?
  headRotation            Float?
  thoracicKyphosisAngle   Float?
  lumbarLordosisAngle     Float?
  trunkLateralShift       Float?
  trunkAngle              Float?
  
  // II. Shoulder & Arm (6 metrics)
  leftShoulderAngle       Float?
  rightShoulderAngle      Float?
  shoulderHeightDiff      Float?
  roundedShoulderAngle    Float?
  leftElbowAngle          Float?
  rightElbowAngle         Float?
  
  // III. Pelvis & Hip (5 metrics)
  leftHipAngle            Float?
  rightHipAngle           Float?
  pelvicObliquity         Float?
  pelvicTiltAngle         Float?
  hipHeightDiff           Float?
  
  // IV. Lower Extremity (9 metrics)
  leftKneeAngle           Float?
  rightKneeAngle          Float?
  kneeVarusValgus         Float?
  kneeFlexionNeutral      Float?
  qAngleLeft              Float?
  qAngleRight             Float?
  footProgressionAngle    Float?
  pronationSupinationLeft Float?
  pronationSupinationRight Float?
  
  // V. Body Proportions (7 metrics)
  shoulderWidth           Float?
  hipWidth                Float?
  torsoLength             Float?
  leftArmLength           Float?
  rightArmLength          Float?
  leftLegLength           Float?
  rightLegLength          Float?
  
  // Raw Data & Status
  landmarksData           Json?
  capturedPoses           String?   // Comma-separated list: "front,side,back"

  // v2 metric payload: per-metric value + status + confidence + citation.
  // The legacy Float columns above are retained for backward compatibility and are
  // now nullable, because a metric that could not be measured must read as null
  // rather than as a fabricated default. New readers should use metricsJson.
  metricsJson             Json?
  schemaVersion           Int       @default(1)
  qualityFlags            Json?     // capture-quality warnings, e.g. assumed aspect ratio

  status                  String    @default("completed")
  isActive                Boolean   @default(true)
  
  // Relations
  user                    User      @relation(fields: [userId], references: [id])
  booking                 Booking   @relation(fields: [bookingId], references: [id])
  poseLandmarks           PoseLandmarks[]
  
  @@index([userId])
  @@index([bookingId])
  @@index([analysisDate])
  @@index([status])
  @@index([bookingId, analysisDate])
}

model PoseLandmarks {
  id            String   @id @default(cuid())
  analysisId    String
  poseType      String   // 'front', 'side', 'back'
  landmarksData Json?    // Landmarks data for this specific pose
  imageData     String?  // Base64 encoded image of the pose
  frameCount    Int      // Number of frames captured for this pose
  createdAt     DateTime @default(now())

  // Relations
  analysis      PostureAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([poseType])
  @@unique([analysisId, poseType])
}

model GaitAnalysis {
  id           String   @id @default(uuid())
  userId       String
  bookingId    String
  analysisDate DateTime @default(now())

  // I. Temporal Parameters (6)
  cadence               Float?  // steps/minute
  strideTimeLeft        Float?  // seconds
  strideTimeRight       Float?  // seconds
  stancePhasePercent    Float?  // % of gait cycle
  swingPhasePercent     Float?  // % of gait cycle
  doubleSupportTime     Float?  // seconds

  // II. Spatial Parameters (6)
  strideLength          Float?  // normalized 0-1
  stepLengthLeft        Float?  // normalized
  stepLengthRight       Float?  // normalized
  stepWidth             Float?  // normalized
  walkingSpeed          Float?  // normalized units/sec
  stepLengthSymmetry    Float?  // 0-100%

  // III. Kinematic Parameters (12)
  hipFlexionMax              Float?  // degrees
  hipExtensionMax            Float?  // degrees
  hipFlexionRom              Float?  // degrees (range of motion)
  kneeFlexionMax             Float?  // degrees
  kneeExtensionMin           Float?  // degrees
  kneeFlexionRom             Float?  // degrees
  leftKneeAngleAvg           Float?  // degrees
  rightKneeAngleAvg          Float?  // degrees
  ankleDorsiflexionMax       Float?  // degrees
  footProgressionAngleLeft   Float?  // degrees
  footProgressionAngleRight  Float?  // degrees
  armSwingAmplitude          Float?  // normalized pixels

  // IV. Trunk & Pelvis (4)
  trunkLateralSway      Float?  // normalized pixels range
  trunkSagittalLean     Float?  // degrees
  pelvicObliquityRange  Float?  // degrees
  armSwingSymmetry      Float?  // 0-100%

  // V. Functional Scores (4)
  gaitSymmetryIndex  Float?  // 0-100%
  stepRegularity     Float?  // 0-1.0
  gaitQualityScore   Float?  // 0-100
  gaitCycleCount     Int?    // number of complete cycles

  // Meta
  capturedViews String?  // "front,leftside,rightside"
  totalFrames   Int?

  // v2 metric payload - see the note on PostureAnalysis.metricsJson.
  metricsJson   Json?
  schemaVersion Int     @default(1)
  qualityFlags  Json?
  cyclesAnalysed Int?

  status        String  @default("completed")
  isActive      Boolean @default(true)

  user       User        @relation(fields: [userId], references: [id])
  booking    Booking     @relation(fields: [bookingId], references: [id])
  gaitFrames GaitFrames[]

  @@index([userId])
  @@index([bookingId])
  @@index([analysisDate])
  @@index([bookingId, analysisDate])
}

model GaitFrames {
  id         String @id @default(cuid())
  analysisId String
  viewType   String  // 'front', 'leftside', 'rightside'

  imageData           String?  // base64 best-frame background image
  annotatedTimeSeries Json?    // [{frameIndex, landmarks:{0:[x,y,z,v],...}, gaitPhase, timestamp}]
  heelStrikes         Json?    // {"left": [12,45,78,...], "right": [28,61,94,...]}
  frameCount          Int

  createdAt DateTime @default(now())

  analysis GaitAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@unique([analysisId, viewType])
}

/// Range-of-motion screening.
///
/// Deliberately has no per-metric columns, unlike PostureAnalysis and GaitAnalysis.
/// Those were built with one column per metric and the columns went stale the moment a
/// metric changed meaning or unit - most of them are NULL today because writing a
/// redefined quantity into a same-named column corrupts every historical comparison
/// drawn from it. metricsJson carries the whole payload: value, unit, status, normal
/// range, citation and confidence, per metric. New readers use it; there is no legacy
/// shape here to be compatible with.
model ROMAnalysis {
  id           String   @id @default(uuid())
  userId       String
  bookingId    String
  analysisDate DateTime @default(now())

  /// Full v2 metric payload, one entry per movement captured.
  metricsJson    Json?
  /// Capture-quality warnings: assumed aspect ratio, wrong-way stances, unsteady holds.
  qualityFlags   Json?
  schemaVersion  Int      @default(2)

  /// Comma-separated movements the patient actually completed.
  capturedMovements String?
  totalFrames       Int?
  status            String  @default("completed")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId, analysisDate])
  @@index([bookingId])
}

// =========================================================================
// Role-specific profiles and calendars
// =========================================================================

/// Everything about a clinician that is not about their login.
///
/// Kept off User deliberately: User carries the identity the auth system needs, and
/// bolting eight nullable clinical columns onto it would mean every patient row
/// carries eight columns that can never be populated.
model ClinicianProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique

  specialisation      String?
  qualifications      String?
  /// Professional registration / licence number. Surfaced to admins only.
  registrationNo      String?
  yearsExperience     Int?
  bio                 String?
  /// Comma-separated ISO language names, e.g. "English,Hindi".
  languages           String?
  consultationModes   String?  @default("video")
  isAcceptingPatients Boolean  @default(true)
  /// IANA name. Availability windows below are stored as local minutes in THIS zone,
  /// so a clinician who sets 09:00-17:00 keeps those hours across daylight saving.
  timezone            String   @default("Asia/Kolkata")
  /// Overrides Service.duration when generating this clinician's slots.
  slotDurationMinutes Int      @default(30)
  /// Hard ceiling on bookings per day, enforced when a slot is taken.
  maxDailyBookings    Int?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability        ClinicianAvailability[]
  timeOff             ClinicianTimeOff[]

  @@index([isAcceptingPatients])
}

/// One recurring weekly window a clinician works.
///
/// Minutes-from-midnight rather than a DateTime: a weekly pattern has no date, and
/// storing one forces every reader to remember to ignore it.
model ClinicianAvailability {
  id                 String   @id @default(uuid())
  clinicianProfileId String
  /// 0 = Monday ... 6 = Sunday, matching Python's date.weekday().
  dayOfWeek          Int
  startMinute        Int
  endMinute          Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  profile            ClinicianProfile @relation(fields: [clinicianProfileId], references: [id], onDelete: Cascade)

  @@unique([clinicianProfileId, dayOfWeek, startMinute])
  @@index([clinicianProfileId, dayOfWeek])
}

/// A dated exception that removes availability: leave, a conference, a blocked morning.
model ClinicianTimeOff {
  id                 String   @id @default(uuid())
  clinicianProfileId String
  startAt            DateTime
  endAt              DateTime
  reason             String?
  createdAt          DateTime @default(now())

  profile            ClinicianProfile @relation(fields: [clinicianProfileId], references: [id], onDelete: Cascade)

  @@index([clinicianProfileId, startAt, endAt])
}

// =========================================================================
// Exercise library and prescription
// =========================================================================

/// One exercise, with the video a patient watches to perform it.
///
/// The canonical definitions live in app/core/exercise/library.py alongside their
/// citations, for the same reason the metric registry lives in code: a prescription
/// nobody can source is a prescription nobody can defend. These rows are seeded from
/// that library so that admins can replace video URLs and retire exercises without a
/// deploy, and so plan items have something to point a foreign key at.
model Exercise {
  id                      String     @id @default(uuid())
  slug                    String     @unique
  name                    String
  summary                 String?
  description             String?

  /// Where the demonstration video lives. Nullable because an exercise may be
  /// catalogued before its video is filmed - the UI then shows instructions only,
  /// rather than a dead player.
  videoUrl                String?
  /// "youtube" | "vimeo" | "mp4" | "hls". Drives which player the frontend mounts.
  videoProvider           String?
  thumbnailUrl            String?
  durationSeconds         Int?

  bodyRegion              BodyRegion
  difficulty              Difficulty @default(BEGINNER)
  /// Comma-separated, e.g. "resistance band,chair". Empty means none needed.
  equipment               String?

  defaultSets             Int        @default(2)
  defaultReps             Int?
  defaultHoldSeconds      Int?
  defaultFrequencyPerWeek Int        @default(5)

  /// Ordered list of plain-language steps: ["Stand tall...", "Tuck your chin..."].
  instructions            Json?
  /// When NOT to do this, shown to patient and clinician both.
  cautions                String?
  reference               String?

  isActive                Boolean    @default(true)
  createdById             String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  createdBy               User?      @relation("ExerciseAuthor", fields: [createdById], references: [id])
  planItems               ExercisePlanItem[]

  @@index([bodyRegion, isActive])
  @@index([isActive])
}

/// A prescription generated from one screening.
///
/// Unique on (analysisType, analysisId): re-running the engine over the same analysis
/// updates the plan rather than stacking a second one, so a patient never sees two
/// contradictory prescriptions drawn from identical measurements.
model ExercisePlan {
  id             String       @id @default(uuid())
  patientId      String
  bookingId      String
  analysisType   AnalysisType
  analysisId     String

  status         PlanStatus   @default(DRAFT)
  title          String?
  /// Plain-language summary of what the screening found.
  summary        String?
  clinicianNotes String?

  /// The findings the engine keyed off, frozen at generation time. Stored rather than
  /// recomputed so a plan stays explainable after the rules change underneath it.
  findings       Json?
  engineVersion  Int          @default(1)

  createdById    String?
  reviewedById   String?
  reviewedAt     DateTime?
  activatedAt    DateTime?
  completedAt    DateTime?
  durationWeeks  Int          @default(4)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  patient        User         @relation("PatientPlans", fields: [patientId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation("PlanAuthor", fields: [createdById], references: [id])
  reviewedBy     User?        @relation("PlanReviewer", fields: [reviewedById], references: [id])
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items          ExercisePlanItem[]

  @@unique([analysisType, analysisId])
  @@index([patientId, status])
  @@index([bookingId])
  @@index([status, createdAt])
}

model ExercisePlanItem {
  id                String         @id @default(uuid())
  planId            String
  exerciseId        String

  sets              Int            @default(2)
  reps              Int?
  holdSeconds       Int?
  frequencyPerWeek  Int            @default(5)
  durationWeeks     Int?

  /// Higher runs first in the patient's list; set from finding severity.
  priority          Int            @default(0)
  displayOrder      Int            @default(0)
  source            PlanItemSource @default(AUTO)

  /// Why this exercise is here, in the patient's own terms, naming the measurement.
  reason            String?
  /// Comma-separated metric keys that triggered it, for audit and for the report.
  triggerMetricKeys String?
  clinicianNote     String?
  /// Soft delete: a clinician striking an auto-suggestion off the plan is itself a
  /// clinical decision worth keeping.
  isRemoved         Boolean        @default(false)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  plan              ExercisePlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise          Exercise       @relation(fields: [exerciseId], references: [id])
  completions       ExerciseCompletion[]

  @@unique([planId, exerciseId])
  @@index([planId, isRemoved])
}

/// A patient logging that they did an exercise. Adherence is the single biggest
/// predictor of whether a home programme works, and without this the clinician is
/// asking at the next appointment.
model ExerciseCompletion {
  id               String   @id @default(uuid())
  planItemId       String
  patientId        String
  completedAt      DateTime @default(now())
  setsDone         Int?
  repsDone         Int?
  /// 0-10 numeric rating scale, the standard used in physiotherapy.
  painScore        Int?
  /// 1-5, how hard it felt. Flags an exercise progressed too fast.
  difficultyRating Int?
  notes            String?

  planItem         ExercisePlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  patient          User             @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([planItemId, completedAt])
  @@index([patientId, completedAt])
}

// =========================================================================
// Video consultation
// =========================================================================

/// A supervised consultation. Also the gate on screening.
///
/// A screening measures a patient's body and produces numbers a clinician will act on.
/// It is not a self-service feature: `screeningEnabled` is flipped only by a CLINICIAN
/// or ADMIN, and a patient's browser may only begin a capture while it is true and it
/// holds the matching `screeningToken`. See app/core/screening_gate.py.
model VideoSession {
  id                      String             @id @default(uuid())
  bookingId               String
  patientId               String
  clinicianId             String?

  /// Signalling room key. Unguessable and unique so a room cannot be joined by
  /// guessing a booking id.
  roomName                String             @unique
  status                  VideoSessionStatus @default(SCHEDULED)

  scheduledAt             DateTime?
  startedAt               DateTime?
  endedAt                 DateTime?
  startedById             String?
  endedById               String?

  screeningEnabled        Boolean            @default(false)
  screeningEnabledAt      DateTime?
  screeningEnabledById    String?
  screeningType           AnalysisType?
  /// Single-use bearer for one capture. Short-lived so a token captured from one
  /// consultation cannot start a screening days later.
  screeningToken          String?            @unique
  screeningTokenExpiresAt DateTime?
  /// Set once the capture it authorised has been finalised, so the same token cannot
  /// be spent twice.
  screeningConsumedAt     DateTime?

  clinicalNotes           String?

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  booking                 Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  patient                 User               @relation("PatientSessions", fields: [patientId], references: [id], onDelete: Cascade)
  clinician               User?              @relation("ClinicianSessions", fields: [clinicianId], references: [id])
  participants            VideoSessionParticipant[]
  events                  VideoSessionEvent[]

  @@index([bookingId])
  @@index([patientId, status])
  @@index([clinicianId, status])
  @@index([status, scheduledAt])
}

model VideoSessionParticipant {
  id           String          @id @default(uuid())
  sessionId    String
  userId       String
  role         ParticipantRole
  /// Per-tab identity for the WebRTC mesh. One user on two devices is two peers.
  connectionId String
  joinedAt     DateTime        @default(now())
  leftAt       DateTime?
  isAudioMuted Boolean         @default(false)
  isVideoMuted Boolean         @default(false)

  session      VideoSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, connectionId])
  @@index([sessionId, leftAt])
  @@index([userId])
}

/// Append-only audit of what happened in a consultation: who joined, who authorised
/// the screening, when it finished. A screening that produced a clinical number needs
/// a record of the clinician who stood behind it.
model VideoSessionEvent {
  id        String       @id @default(uuid())
  sessionId String
  userId    String?
  /// "joined" | "left" | "screening_enabled" | "screening_started" |
  /// "screening_completed" | "screening_revoked" | "chat" | "ended" | ...
  type      String
  payload   Json?
  createdAt DateTime     @default(now())

  session   VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])

  @@index([sessionId, createdAt])
  @@index([type, createdAt])
}
