// =========================
// Generator & Datasource
// =========================
generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// =========================
// Enums
// =========================
enum UserRole {
  USER
  CLINICIAN
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OtpType {
  LOGIN
  SIGNUP
  RESET
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentType {
  FULL
  PARTIAL
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
  REFUNDED
}

// =========================
// Models
// =========================

model User {
  id                     String        @id @default(uuid())
  email                  String?       @unique
  name                   String?
  role                   UserRole
  phone                  String        @unique
  passwordHash           String?
  status                 UserStatus    @default(ACTIVE)
  createdAt              DateTime      @default(now())
  profileImage           String?
  sessionCount           Int           @default(0)
  notificationPreference Json?

  carts                  Cart[]
  bookings               Booking[]
  subscriptions          Subscription[]
  reports                Report[]
  payments               Payment[]
  postureAnalyses        PostureAnalysis[]
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  status      String?
  createdAt   DateTime @default(now())

  services    Service[]
  
  @@index([status])
  @@index([slug])
}

model Service {
  id              String      @id @default(uuid())
  categoryId      String
  name            String
  slug            String      @unique
  description     String?
  
  // Pricing
  basePrice       Float
  salePrice       Float?
  discount        Float?
  
  // Payment Configuration
  paymentType     PaymentType @default(FULL)
  advancePercent  Float?
  advanceAmount   Float?
  
  // Service Metadata
  duration        String?
  serviceType     String?
  features        Json?
  reviewCount     Int         @default(0)
  deliveryMode    String?
  sessionCount    Int?
  
  // AI Screening Configuration
  includedScreeningCount  Int?
  
  createdAt       DateTime    @default(now())

  category        Category         @relation(fields: [categoryId], references: [id])
  bookings        Booking[]
  subscriptions   Subscription[]
  
  @@index([categoryId])
  @@index([slug])
  @@index([paymentType])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String
  cartValue Float    @default(0)

  items     Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  otp       String
  phoneNo   String
  type      OtpType
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phoneNo])
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float         @default(0)
  
  status          PaymentStatus @default(PENDING)
  paymentMethod   String?
  transactionId   String?
  
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  
  user            User          @relation(fields: [userId], references: [id])
  bookings        Booking[]
  
  @@index([userId])
  @@index([transactionId])
}

model Booking {
  id          String        @id @default(uuid())
  userId      String
  serviceId   String
  paymentId   String
  clinicianId String?
  
  totalAmount     Float
  paidAmount      Float
  remainingAmount Float     @default(0)
  
  time        DateTime
  createdAt   DateTime      @default(now())
  status      BookingStatus @default(PENDING)
  description String?
  
  // AI Screening Count Management
  totalScreeningCount     Int       @default(0)
  usedScreeningCount      Int       @default(0)
  remainingScreeningCount Int       @default(0)

  user        User          @relation(fields: [userId], references: [id])
  service     Service       @relation(fields: [serviceId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
  reports     Report[]
  postureAnalyses PostureAnalysis[]

  @@index([userId])
  @@index([serviceId])
  @@index([paymentId])
  @@index([userId, remainingScreeningCount])
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  bookingId   String
  reportUrl   String
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model Subscription {
  id           String   @id @default(uuid())
  userId       String
  serviceId    String
  amount       Float
  createdAt    DateTime @default(now())
  startAt      DateTime
  expirationAt DateTime

  user         User     @relation(fields: [userId], references: [id])
  service      Service  @relation(fields: [serviceId], references: [id])

  @@index([userId])
  @@index([serviceId])
}

model PostureAnalysis {
  id                      String    @id @default(uuid())
  userId                  String
  bookingId               String
  analysisDate            DateTime  @default(now())
  
  // I. Global Posture (8 metrics)
  fhdPixels               Float
  cervicalAngle           Float
  headLateralFlexion      Float
  headRotation            Float
  thoracicKyphosisAngle   Float
  lumbarLordosisAngle     Float
  trunkLateralShift       Float
  trunkAngle              Float
  
  // II. Shoulder & Arm (6 metrics)
  leftShoulderAngle       Float
  rightShoulderAngle      Float
  shoulderHeightDiff      Float
  roundedShoulderAngle    Float
  leftElbowAngle          Float
  rightElbowAngle         Float
  
  // III. Pelvis & Hip (5 metrics)
  leftHipAngle            Float
  rightHipAngle           Float
  pelvicObliquity         Float
  pelvicTiltAngle         Float
  hipHeightDiff           Float
  
  // IV. Lower Extremity (9 metrics)
  leftKneeAngle           Float
  rightKneeAngle          Float
  kneeVarusValgus         Float
  kneeFlexionNeutral      Float
  qAngleLeft              Float
  qAngleRight             Float
  footProgressionAngle    Float
  pronationSupinationLeft Float
  pronationSupinationRight Float
  
  // V. Body Proportions (7 metrics)
  shoulderWidth           Float
  hipWidth                Float
  torsoLength             Float
  leftArmLength           Float
  rightArmLength          Float
  leftLegLength           Float
  rightLegLength          Float
  
  // Raw Data & Status
  landmarksData           Json?
  status                  String    @default("completed")
  isActive                Boolean   @default(true)
  
  // Relations
  user                    User      @relation(fields: [userId], references: [id])
  booking                 Booking   @relation(fields: [bookingId], references: [id])
  
  @@index([userId])
  @@index([bookingId])
  @@index([analysisDate])
  @@index([status])
  @@index([bookingId, analysisDate])
}
// Add to the end of the file, before the last closing brace

model PoseLandmarks {
  id            String   @id @default(cuid())
  analysisId    String
  poseType      String   // 'front', 'side', 'back'
  landmarksData Json?    // Landmarks data for this specific pose
  imageData     String?  // Base64 encoded image of the pose
  frameCount    Int      // Number of frames captured for this pose
  createdAt     DateTime @default(now())
  
  // Relations
  analysis      PostureAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  
  @@index([analysisId])
  @@index([poseType])
  @@unique([analysisId, poseType])
}

// Add poseType to PostureAnalysis to track which poses were captured
model PostureAnalysis {
  // ... existing fields remain the same ...
  
  // Add new field to track which poses were captured
  capturedPoses    String?  // Comma-separated list: "front,side,back"
  
  // Add relationship to PoseLandmarks
  poseLandmarks PoseLandmarks[]
  
  // ... rest of the model remains the same
}